---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allPosts, groupByYear, postUrl, formatDate } from '../lib/posts';
const groups = groupByYear(await allPosts());
---
<BaseLayout title="Archive">
  <div class="page-heading"><span class="eyebrow">A TIMELINE OF THOUGHTS</span><h1>Archive<span class="accent-dot">.</span></h1><p>Một dòng thời gian của những điều đã ghi lại.</p></div>
  <div class="archive">{groups.map(([year, posts]) => <section class="archive-year"><h2>{year}</h2><div>{posts.map(post => <a class="archive-item" href={postUrl(post)}><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{post.data.title}</span><span class="archive-arrow">↗</span></a>)}</div></section>)}</div>
</BaseLayout>

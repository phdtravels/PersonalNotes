---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/posts';
import { formatDate, tagUrl, withBase } from '../lib/posts';
interface Props { post: Post; }
const { post } = Astro.props;
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <a class="back-link" href={withBase(post.data.category === 'tech' ? '/tech/' : '/journal/')}>← Quay lại {post.data.category === 'tech' ? 'Tech' : 'Journal'}</a>
    <header class="article-header">
      <div class="eyebrow"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span class="meta-dot">·</span>{post.data.category === 'tech' ? 'Tech' : 'Journal'}</div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {post.data.updatedDate && <p class="muted small">Cập nhật: {formatDate(post.data.updatedDate)}</p>}
    </header>
    <div class="prose"><slot /></div>
    <div class="article-bottom"><div class="post-tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div><a class="back-link" href={withBase('/')}>← Về trang chủ</a></div>
  </article>
</BaseLayout>
